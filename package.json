{
    "name": "pi-hybrid-memory",
    "version": "0.1.0",
    "description": "Hybrid memory extension for pi — merges semantic observational memory with structural VCC compaction into a single unified summary",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OtwakO/pi-hybrid-memory.git"
    },
    "keywords": [
        "pi",
        "pi-agent",
        "pi-package",
        "extension",
        "hybrid-memory",
        "compaction"
    ],
    "pi": {
        "extensions": [
            "./dist/pi-hybrid-memory/index.js"
        ]
    },
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "bun build ./src/index.ts --outfile ./dist/pi-hybrid-memory/index.js --target bun --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external @earendil-works/pi-ai --external typebox --format esm",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "evaluate:retirement": "bun evaluation/semantic-retirement/run.ts",
        "validate:live": "bun evaluation/live-validation/run.ts"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "^0.84.3",
        "@earendil-works/pi-ai": "^0.84.3",
        "@earendil-works/pi-coding-agent": "^0.84.3",
        "@earendil-works/pi-tui": "^0.84.3",
        "typebox": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "0.84.3",
        "@earendil-works/pi-ai": "0.84.3",
        "@earendil-works/pi-coding-agent": "0.84.3",
        "@earendil-works/pi-tui": "0.84.3",
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0",
        "vitest": "^4.1.5"
    }
}
